{
    "name": "letterncms/assistant",
    "description": "Claude in the workspace: it answers in plain words and builds and edits the site with abilities, as the signed-in user.",
    "type": "cms-plugin",
    "version": "0.7.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.7 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Assistant\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Assistant",
            "icon": "sparkle",
            "provider": "Cms\\Assistant\\AssistantPlugin",
            "provides": [
                "assistant"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/assistant"
}
