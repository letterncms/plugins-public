{
    "name": "letterncms/youtube",
    "description": "A YouTube block that shows the video’s poster and loads YouTube only when a visitor plays it: fast pages, no cookies before they choose.",
    "type": "cms-plugin",
    "version": "0.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.36 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Youtube\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "YouTube",
            "icon": "youtube-logo",
            "provider": "Cms\\Youtube\\YoutubePlugin",
            "modules": [
                "letterncms/blocks"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/youtube"
}
