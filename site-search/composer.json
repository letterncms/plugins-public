{
    "name": "letterncms/site-search",
    "description": "A search field for any page and a page of results, for sites people mostly search: works without JavaScript, accessible to WCAG 2.2 AA.",
    "type": "cms-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.36 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\SiteSearch\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Site Search",
            "icon": "magnifying-glass",
            "provider": "Cms\\SiteSearch\\SiteSearchPlugin",
            "modules": [
                "letterncms/site"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/site-search"
}
