{
    "name": "letterncms/import",
    "description": "Bring a site over: WordPress exports with their media and old addresses, CSV files and folders of Markdown, previewed first and safe to run again.",
    "type": "cms-plugin",
    "version": "0.4.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.28 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Import\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Import",
            "icon": "download",
            "provider": "Cms\\Import\\ImportPlugin"
        }
    },
    "homepage": "https://github.com/letterncms/import"
}
