{
  "name": "Starter",
  "tokens": {
    "color": {
      "$type": "color",
      "background": {
        "$value": "#ffffff",
        "$extensions": {
          "cms": {
            "dark": "#0c0c0b"
          }
        }
      },
      "surface": {
        "$value": "#f6f6f4",
        "$extensions": {
          "cms": {
            "dark": "#161615"
          }
        }
      },
      "foreground": {
        "$value": "#161614",
        "$extensions": {
          "cms": {
            "dark": "#f2f2ee"
          }
        }
      },
      "muted": {
        "$value": "#6b6b66",
        "$extensions": {
          "cms": {
            "dark": "#9c9c96"
          }
        }
      },
      "border": {
        "$value": "#e6e6e2",
        "$extensions": {
          "cms": {
            "dark": "#2a2a27"
          }
        }
      },
      "primary": {
        "$value": "#1d4ed8",
        "$extensions": {
          "cms": {
            "dark": "#7aa2ff"
          }
        }
      },
      "primary-foreground": {
        "$value": "#ffffff",
        "$extensions": {
          "cms": {
            "dark": "#0c0c0b"
          }
        }
      },
      "accent": {
        "$value": "#ff5a1f"
      }
    },
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ]
      }
    },
    "text": {
      "$type": "dimension",
      "xs": {
        "$value": "0.8125rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "base": {
        "$value": {
          "min": "1rem",
          "max": "1.0625rem"
        }
      },
      "lg": {
        "$value": {
          "min": "1.125rem",
          "max": "1.25rem"
        }
      },
      "xl": {
        "$value": {
          "min": "1.25rem",
          "max": "1.5rem"
        }
      },
      "2xl": {
        "$value": {
          "min": "1.5rem",
          "max": "2rem"
        }
      },
      "3xl": {
        "$value": {
          "min": "1.875rem",
          "max": "2.75rem"
        }
      },
      "4xl": {
        "$value": {
          "min": "2.25rem",
          "max": "3.75rem"
        }
      },
      "5xl": {
        "$value": {
          "min": "2.75rem",
          "max": "5rem"
        }
      }
    },
    "leading": {
      "tight": {
        "$value": "1.1"
      },
      "snug": {
        "$value": "1.3"
      },
      "normal": {
        "$value": "1.6"
      }
    },
    "tracking": {
      "tight": {
        "$value": "-0.025em"
      },
      "normal": {
        "$value": "0"
      },
      "wide": {
        "$value": "0.06em"
      }
    },
    "weight": {
      "regular": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "semibold": {
        "$value": "600"
      },
      "bold": {
        "$value": "700"
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0"
      },
      "1": {
        "$value": "0.25rem"
      },
      "2": {
        "$value": "0.5rem"
      },
      "3": {
        "$value": "0.75rem"
      },
      "4": {
        "$value": "1rem"
      },
      "6": {
        "$value": "1.5rem"
      },
      "8": {
        "$value": "2rem"
      },
      "12": {
        "$value": "3rem"
      },
      "16": {
        "$value": "4rem"
      },
      "24": {
        "$value": "6rem"
      },
      "gutter": {
        "$value": {
          "min": "1.25rem",
          "max": "2.5rem"
        }
      },
      "section": {
        "$value": {
          "min": "4rem",
          "max": "8rem"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0"
      },
      "sm": {
        "$value": "0.375rem"
      },
      "md": {
        "$value": "0.625rem"
      },
      "lg": {
        "$value": "1rem"
      },
      "full": {
        "$value": "9999px"
      }
    },
    "shadow": {
      "sm": {
        "$value": "0 1px 2px rgb(0 0 0 / 0.06)"
      },
      "md": {
        "$value": "0 4px 16px -4px rgb(0 0 0 / 0.12)"
      },
      "lg": {
        "$value": "0 24px 48px -16px rgb(0 0 0 / 0.2)"
      }
    },
    "container": {
      "prose": {
        "$value": "42rem"
      },
      "content": {
        "$value": "72rem"
      },
      "wide": {
        "$value": "84rem"
      }
    },
    "breakpoint": {
      "sm": {
        "$value": "640px"
      },
      "md": {
        "$value": "768px"
      },
      "lg": {
        "$value": "1024px"
      },
      "xl": {
        "$value": "1280px"
      }
    },
    "duration": {
      "fast": {
        "$value": "150ms"
      },
      "base": {
        "$value": "300ms"
      },
      "slow": {
        "$value": "600ms"
      }
    },
    "ease": {
      "out": {
        "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)"
      },
      "in-out": {
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    }
  },
  "fonts": [
    {
      "family": "Inter",
      "src": "fonts/InterVariable.woff2",
      "weight": "100 900",
      "style": "normal",
      "preload": true
    }
  ],
  "styles": {
    "body": {
      "fontFamily": "token:font.sans",
      "fontSize": "token:text.base",
      "lineHeight": "token:leading.normal",
      "color": "token:color.foreground",
      "backgroundColor": "token:color.background"
    },
    "h1": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.5xl",
      "lineHeight": "token:leading.tight",
      "letterSpacing": "token:tracking.tight",
      "fontWeight": "token:weight.semibold",
      "textWrap": "balance"
    },
    "h2": {
      "fontFamily": "token:font.display",
      "fontSize": "token:text.3xl",
      "lineHeight": "token:leading.tight",
      "letterSpacing": "token:tracking.tight",
      "fontWeight": "token:weight.semibold",
      "textWrap": "balance"
    },
    "h3": {
      "fontSize": "token:text.xl",
      "lineHeight": "token:leading.snug",
      "fontWeight": "token:weight.semibold"
    },
    "a": {
      "color": "inherit",
      "textUnderlineOffset": "0.2em"
    },
    "code": {
      "fontFamily": "token:font.mono",
      "fontSize": "0.9em"
    },
    "::selection": {
      "backgroundColor": "token:color.primary/20"
    }
  },
  "prose": {
    "h2": {
      "fontSize": "token:text.2xl"
    }
  },
  "buttons": {
    "primary": {
      "base": {
        "backgroundColor": "token:color.primary",
        "color": "token:color.primary-foreground"
      },
      "hover": {
        "opacity": 0.9
      }
    },
    "secondary": {
      "base": {
        "backgroundColor": "transparent",
        "color": "token:color.foreground",
        "borderColor": "token:color.border"
      },
      "hover": {
        "backgroundColor": "token:color.surface"
      }
    }
  },
  "transition": {
    "type": "fade",
    "duration": 0.25
  }
}
