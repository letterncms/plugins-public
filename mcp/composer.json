{
    "name": "letterncms/mcp",
    "description": "Connect AI clients over the Model Context Protocol: every ability becomes a tool, signed in with OAuth.",
    "type": "cms-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.2 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Mcp\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "MCP",
            "icon": "mcp",
            "provider": "Cms\\Mcp\\McpPlugin",
            "provides": [
                "mcp"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/mcp"
}
