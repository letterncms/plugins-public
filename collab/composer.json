{
    "name": "letterncms/collab",
    "description": "Work together: who is viewing or editing a page, comment threads with @mentions and email notifications, and an inbox of what needs you.",
    "type": "cms-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.1 <1"
    },
    "suggest": {
        "letterncms/mail": "Email notifications for mentions and replies"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Collab\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Collaboration",
            "icon": "users",
            "provider": "Cms\\Collab\\CollabPlugin",
            "provides": [
                "comments",
                "presence"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/collab"
}
