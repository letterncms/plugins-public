{
    "name": "letterncms/media",
    "description": "Media library: safe uploads, folders, alt text, focal points and responsive AVIF/WebP images.",
    "type": "cms-plugin",
    "version": "0.5.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.5 <1",
        "ext-gd": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Media\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Media",
            "icon": "media",
            "provider": "Cms\\Media\\MediaPlugin",
            "provides": [
                "media",
                "image-processing"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/media"
}
