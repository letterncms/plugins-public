{
    "name": "letterncms/i18n",
    "description": "Multilingual sites: languages, translations linked to their original, localized URLs, hreflang, language switcher and AI translation.",
    "type": "cms-plugin",
    "version": "0.2.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.4 <1"
    },
    "suggest": {
        "letterncms/assistant": "Translate entries with Claude",
        "letterncms/seo": "hreflang alternates in pages and the sitemap"
    },
    "autoload": {
        "psr-4": {
            "Cms\\I18n\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Languages",
            "icon": "translate",
            "provider": "Cms\\I18n\\I18nPlugin",
            "provides": [
                "i18n"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/i18n"
}
