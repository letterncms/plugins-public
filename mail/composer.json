{
    "name": "letterncms/mail",
    "description": "Email delivery for the CMS and its plugins: SMTP, sendmail or log, provider plugins, branded templates and a delivery log.",
    "type": "cms-plugin",
    "version": "0.3.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.5 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Mail\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Email",
            "icon": "mail",
            "provider": "Cms\\Mail\\MailPlugin",
            "provides": [
                "mail"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/mail"
}
