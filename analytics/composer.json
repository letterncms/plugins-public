{
    "name": "letterncms/analytics",
    "description": "Site analytics on your own server: page views by default, and visitors, goals, funnels, page speed and Google Search as an option.",
    "type": "cms-plugin",
    "version": "0.10.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.48 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Analytics\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Analytics",
            "icon": "chart",
            "provider": "Cms\\Analytics\\AnalyticsPlugin",
            "sync": {
                "groups": {
                    "analytics": {
                        "label": "Analytics",
                        "description": "Page views and visitors.",
                        "tables": [
                            "analytics_*"
                        ],
                        "push": false
                    }
                }
            }
        }
    },
    "homepage": "https://github.com/letterncms/analytics"
}
