{
    "name": "letterncms/forms",
    "description": "Form builder on the block editor, spam-protected submissions for static sites, notifications, confirmations, webhooks and an inbox.",
    "type": "cms-plugin",
    "version": "0.13.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.22 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Forms\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Forms",
            "icon": "form",
            "provider": "Cms\\Forms\\FormsPlugin",
            "modules": [
                "letterncms/blocks"
            ],
            "sync": {
                "groups": {
                    "forms": {
                        "label": "Form Submissions",
                        "description": "What visitors sent through forms.",
                        "tables": [
                            "form_submissions"
                        ],
                        "push": false
                    }
                }
            }
        }
    },
    "homepage": "https://github.com/letterncms/forms"
}
