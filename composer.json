{
    "name": "letterncms/plugins-public",
    "description": "The free plugins, for working on them. Each folder is its own package.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "letterncms/cms": "dev-main as 0.9.0",
        "letterncms/analytics": "*",
        "letterncms/assistant": "*",
        "letterncms/blocks": "*",
        "letterncms/brevo": "*",
        "letterncms/collab": "*",
        "letterncms/forms": "*",
        "letterncms/i18n": "*",
        "letterncms/mail": "*",
        "letterncms/mcp": "*",
        "letterncms/media": "*",
        "letterncms/navigation": "*",
        "letterncms/seo": "*",
        "letterncms/site": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Analytics\\Tests\\": "analytics/tests/",
            "Cms\\Assistant\\Tests\\": "assistant/tests/",
            "Cms\\Blocks\\Tests\\": "blocks/tests/",
            "Cms\\Collab\\Tests\\": "collab/tests/",
            "Cms\\Forms\\Tests\\": "forms/tests/",
            "Cms\\I18n\\Tests\\": "i18n/tests/",
            "Cms\\Mail\\Tests\\": "mail/tests/",
            "Cms\\Mcp\\Tests\\": "mcp/tests/",
            "Cms\\Media\\Tests\\": "media/tests/",
            "Cms\\Navigation\\Tests\\": "navigation/tests/",
            "Cms\\Seo\\Tests\\": "seo/tests/",
            "Cms\\Site\\Tests\\": "site/tests/",
            "Cms\\Tests\\": "vendor/letterncms/cms/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "letterncms/composer-plugin": true
        },
        "preferred-install": {
            "letterncms/cms": "source",
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
