{
    "name": "letterncms/plugins-public",
    "description": "The free plugins, for working on them. Each folder is its own package.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "letterncms/cms": "dev-main as 0.21.0",
        "letterncms/analytics": "*",
        "letterncms/brevo": "*",
        "letterncms/consent": "*",
        "letterncms/forms": "*",
        "letterncms/import": "*",
        "letterncms/seo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Analytics\\Tests\\": "analytics/tests/",
            "Cms\\Brevo\\Tests\\": "brevo/tests/",
            "Cms\\Consent\\Tests\\": "consent/tests/",
            "Cms\\Forms\\Tests\\": "forms/tests/",
            "Cms\\Import\\Tests\\": "import/tests/",
            "Cms\\Seo\\Tests\\": "seo/tests/",
            "Cms\\Tests\\": "vendor/letterncms/cms/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "letterncms/composer-plugin": true
        },
        "preferred-install": {
            "letterncms/cms": "source",
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
