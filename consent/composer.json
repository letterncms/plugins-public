{
    "name": "letterncms/consent",
    "description": "A cookie-consent banner in your site’s own design: visitors choose analytics and marketing, and scripts wait for their answer.",
    "type": "cms-plugin",
    "version": "0.3.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letterncms/cms": ">=0.24 <1"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Consent\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Consent",
            "icon": "shield",
            "provider": "Cms\\Consent\\ConsentPlugin",
            "modules": [
                "letterncms/site"
            ]
        }
    },
    "homepage": "https://github.com/letterncms/consent"
}
